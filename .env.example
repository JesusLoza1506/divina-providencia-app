# ===================================
# CONFIGURACIÓN GENERAL
# ===================================
NODE_ENV=development
APP_NAME="Aula Virtual Divina Providencia"

# ===================================
# INFRAESTRUCTURA (DOCKER)
# ===================================
# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=divina_providencia_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ===================================
# SERVICIOS BACKEND (NestJS)
# ===================================
BACKEND_PORT=3000
JWT_SECRET=super_secreto_cambiar_en_produccion

# ===================================
# SERVICIO DE IA (FastAPI / Python)
# ===================================
AI_SERVICE_PORT=8000
ANTHROPIC_API_KEY=tu_api_key_de_claude_aqui

# ===================================
# FRONTEND (Next.js)
# ===================================
NEXT_PUBLIC_API_URL=http://localhost:3000/api